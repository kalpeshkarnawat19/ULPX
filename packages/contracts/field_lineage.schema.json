{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulpfx.local/contracts/field_lineage/1.0",
  "title": "FieldLineage",
  "type": "object",
  "additionalProperties": false,
  "required": ["normalized_path", "raw_locator", "extractor", "transformations", "mapping_score", "mapping_evidence", "review_status"],
  "properties": {
    "normalized_path": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$"},
    "raw_locator": {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"type": "string", "enum": ["key", "json_pointer", "offset", "regex_group"]}, "value": {"type": "string", "minLength": 1}}},
    "extractor": {"type": "string", "enum": ["key_value", "json_pointer", "regex_capture", "cef_parse", "leef_parse", "syslog_parse", "kv"]},
    "transformations": {"type": "array", "items": {"type": "string", "enum": ["trim", "lowercase", "uppercase", "integer", "float", "boolean", "ip", "timestamp", "enum_map", "split", "join", "substring"]}},
    "mapping_score": {"type": "number", "minimum": 0, "maximum": 1},
    "mapping_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["alias_match", "type_match", "event_family_context", "schema_description_similarity", "value_profile"]}},
    "review_status": {"type": "string", "enum": ["AUTO_ACCEPTED", "HUMAN_APPROVED", "ABSTAINED", "REJECTED"]}
  }
}
