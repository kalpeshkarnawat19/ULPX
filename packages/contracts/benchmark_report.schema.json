{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BenchmarkReport",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "timestamp",
    "hardware",
    "target",
    "workload",
    "results",
    "claims"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "report_id": {
      "type": "string",
      "minLength": 3
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "hardware": {
      "type": "object",
      "required": [
        "cpu_model",
        "cpu_cores",
        "memory_total_mb",
        "os_platform",
        "python_version"
      ],
      "additionalProperties": false,
      "properties": {
        "cpu_model": {
          "type": "string",
          "minLength": 1
        },
        "cpu_cores": {
          "type": "integer",
          "minimum": 1
        },
        "memory_total_mb": {
          "type": "number",
          "minimum": 0
        },
        "os_platform": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "component",
        "parser_id",
        "parser_version"
      ],
      "additionalProperties": false,
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "parser_runtime",
            "normalize_worker",
            "ingest_gateway",
            "shadow_runner",
            "end_to_end"
          ]
        },
        "parser_id": {
          "type": "string",
          "minLength": 1
        },
        "parser_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workload": {
      "type": "object",
      "required": [
        "event_count",
        "duration_seconds",
        "concurrency",
        "batch_size"
      ],
      "additionalProperties": false,
      "properties": {
        "event_count": {
          "type": "integer",
          "minimum": 1
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "target_eps": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "results": {
      "type": "object",
      "required": [
        "measured_eps",
        "total_events_processed",
        "total_errors",
        "parse_success_rate",
        "latency_ms",
        "resource_utilization"
      ],
      "additionalProperties": false,
      "properties": {
        "measured_eps": {
          "type": "number",
          "minimum": 0
        },
        "total_events_processed": {
          "type": "integer",
          "minimum": 0
        },
        "total_errors": {
          "type": "integer",
          "minimum": 0
        },
        "parse_success_rate": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "latency_ms": {
          "type": "object",
          "required": [
            "p50",
            "p90",
            "p99",
            "mean",
            "min",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "p50": { "type": "number", "minimum": 0 },
            "p90": { "type": "number", "minimum": 0 },
            "p99": { "type": "number", "minimum": 0 },
            "mean": { "type": "number", "minimum": 0 },
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          }
        },
        "resource_utilization": {
          "type": "object",
          "required": [
            "cpu_percent",
            "memory_peak_mb",
            "queue_depth_max"
          ],
          "additionalProperties": false,
          "properties": {
            "cpu_percent": { "type": "number", "minimum": 0 },
            "memory_peak_mb": { "type": "number", "minimum": 0 },
            "queue_depth_max": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "required": [
        "target_5k_eps_claimed",
        "target_5k_eps_verified",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "target_5k_eps_claimed": {
          "type": "boolean"
        },
        "target_5k_eps_verified": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
