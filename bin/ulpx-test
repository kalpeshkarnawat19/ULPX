#!/usr/bin/env bash
# ULPF-X Continuous Security Audit & Verification CLI Launcher
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if command -v python3 >/dev/null 2>&1; then
    exec python3 "$ENGINE_ROOT/scripts/audit.py" "$@"
elif command -v python >/dev/null 2>&1; then
    exec python "$ENGINE_ROOT/scripts/audit.py" "$@"
else
    echo "Error: Python 3 runtime not found in PATH." >&2
    exit 1
fi
