#!/usr/bin/env bash
# ULPF-X Shorthand Launcher: NDJSON / JSON Lines Log Sink
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -x "$SCRIPT_DIR/ulpx" ]; then
    exec "$SCRIPT_DIR/ulpx" export --format ndjson "$@"
elif command -v ulpx >/dev/null 2>&1; then
    exec ulpx export --format ndjson "$@"
fi
echo "Error: 'ulpx' executable not found in $SCRIPT_DIR or PATH." >&2
exit 1
